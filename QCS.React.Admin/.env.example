# Public base path for both BrowserRouter basename and Vite asset URLs.
# Production IIS example for this repository: /QCS/admin
# Use / only when hosting the SPA at site root.
VITE_QCS_ADMIN_APP_BASE_PATH=/

# Backend API (ASP.NET Core / QCS.API)
# Production IIS example for this repository: /QCS/Service
VITE_QCS_API_BASE_URL=https://localhost:7001

# SignalR hub endpoint (leave blank to disable hub connection)
# Production IIS example for this repository: /QCS/Service/hubs/qcs
VITE_QCS_HUB_URL=https://localhost:7001/hubs/qcs

# Legacy MVC portal base URL (used for quotation view links)
# Production IIS example for this repository: /QCS
VITE_QCS_PORTAL_BASE_URL=https://ap-ntc2137-prwb/QCS