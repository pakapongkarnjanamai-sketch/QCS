@using QCS.Domain.Enum
@using QCS.Infrastructure.Services
@{
    ViewData["Title"] = "ใบเสนอราคา (Quotation)";
    Layout = "_DevExtremeLayout";
}

<div class="container-fluid full-height-container mt-3">
    <div class="qcs-card-content">

        <div class="d-flex align-items-center mb-3 pb-2 border-bottom flex-shrink-0">
            <h6 class="m-0 fw-bold text-header">
                <i class="fas fa-file-invoice-dollar me-2" style="color: var(--dx-primary-color);"></i> @ViewData["Title"]
            </h6>
        </div>

        <div class="grid-wrapper">
            <div id="gridContainer"></div>
        </div>

    </div>
</div>

@section Scripts {


    <script>
        $(function () {
            const DETAIL_URL = '@Url.Action("View", "Quotation")';

        // 1. ดึงข้อมูล Enum WorkflowStep จาก Server (Inject via C#)
              const workflowStepSource = @Html.Raw(Json.Serialize(EnumHelper.ToList<WorkflowStep>()));

              // === HELPER: Status Badge ===
              const getStatusBadgeInfo = (statusId) => {
                  let badgeClass = "bg-secondary-soft";

                  // ค้นหาข้อความจาก Enum (ป้องกันการ Hardcode)
                  const statusEnum = workflowStepSource.find(x => x.Id === statusId);
                  const text = statusEnum ? statusEnum.DisplayName : "Unknown";

                  // กำหนดสีตาม WorkflowStep
                  switch (statusId) {
                     case 0: // Draft
                        badgeClass = "bg-secondary-soft  text-dark";
                        break;
                    case 1: // Purchaser
                        badgeClass = "bg-info-soft  text-dark";
                        break;
                    case 2: // Verifier
                        badgeClass = "bg-warning-soft  text-dark";
                        break;
                    case 3: // Manager
                        badgeClass = "bg-warning-soft text-dark";
                        break;
                    case 99: // Completed
                        badgeClass = "bg-success-soft text-dark";
                        break;
                    case -1: // Rejected
                        badgeClass = "bg-danger-soft text-dark";
                        break;
                    default:
                    badgeClass = "bg-light text-muted border";
                        break;
                  }

                  return { cls: badgeClass, txt: text };
              };


            // === MAIN GRID ===
            const grid = $("#gridContainer").dxDataGrid({
                dataSource: DevExpress.data.AspNet.createStore({
                    key: "id",
                    loadUrl: `${API_BASE}/Request/ApprovedList`,
                    onBeforeSend: function (method, ajaxOptions) {
                        ajaxOptions.xhrFields = { withCredentials: true };
                    }
                }),
                height: "100%",
                showBorders: true,
                rowAlternationEnabled: true,
                hoverStateEnabled: true,
                columnAutoWidth: true,
                scrolling: { mode: "virtual" },
                searchPanel: { visible: true, width: 350, placeholder: "ค้นหาเอกสาร..." },
                headerFilter: { visible: true },
                columns: [
                    {
                        dataField: "code",
                        caption: "เลขที่เอกสาร",
                        width: 120,
                        sortOrder: "desc",
                        cellTemplate: (container, options) => {
                            $("<a>")
                                .addClass("doc-link")
                                .text(options.value)
                                .attr("href", `${DETAIL_URL}/${options.value}`)
                                .attr("target", "_blank")
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "title",
                        caption: "หัวข้อ/รายการ",
                        minWidth: 180
                    },
                    {
                        dataField: "requesterName",
                        caption: "ผู้ขอ",
                        width: 180
                    },
                    {
                        dataField: "vendorName",
                        caption: "ผู้ขาย (Vendor)",
                        width: 320,
                        calculateDisplayValue: (rowData) => {
                            return rowData.vendorCode
                                ? `${rowData.vendorCode} : ${rowData.vendorName}`
                                : rowData.vendorName;
                        }
                    },
                    {
                        dataField: "requestDate",
                        caption: "วันที่ขอ",
                        dataType: "date",
                        format: "yyyy-MM-dd",
                        width: 120,
                        alignment: "center"
                    },
                    {
                        dataField: "currentStepId",
                        caption: "สถานะ",
                        width: 150,
                        alignment: "center",
                        lookup: {
                            dataSource: [
                                { id: 0, name: "บันทึก (Draft)" },
                                { id: 1, name: "บันทึก (Purchaser)" },
                                { id: 2, name: "รอตรวจสอบ (Verifier)" },
                                { id: 3, name: "รออนุมัติ (Manager)" },
                                { id: 99, name: "อนุมัติครบถ้วน (Completed)" },
                                { id: -1, name: "ไม่อนุมัติ (Rejected)" }
                            ],
                            valueExpr: "id",
                            displayExpr: "name"
                        },
                        cellTemplate: (container, options) => {
                            const info = getStatusBadgeInfo(options.value);
                            $("<span>")
                                .addClass("status-badge " + info.cls)
                                .text(info.txt)
                                .appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        width: 70,
                        buttons: [{
                            hint: "ดูรายละเอียด",
                            icon: "find",
                            onClick: function (e) {
                                window.open(`${DETAIL_URL}/${e.row.data.code}`, '_blank');
                            }
                        }]
                    }
                ]
            }).dxDataGrid("instance");

            // === ✅ 2. REAL-TIME SIGNALR SETUP ===

            // เตรียม URL (ตัด /api ออกถ้ามี เพื่อชี้ไปที่ Root)
            const hubBaseUrl = (typeof API_BASE !== 'undefined') ? API_BASE : "https://localhost:7127";
            const rootUrl = hubBaseUrl.replace(/\/api\/?$/, "");
            const hubUrl = `${rootUrl}/notificationHub`;

            // สร้าง Connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl(hubUrl)
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            // รับ Event และสั่ง Refresh Grid
            connection.on("ReceiveUpdate", function (message) {
                console.log("SignalR Update (List):", message);

                // แจ้งเตือนเล็กๆ (Optional)
                // DevExpress.ui.notify({
                //     message: "ข้อมูลอัปเดต: " + message,
                //     type: "info",
                //     displayTime: 2000,
                //     width: 300,
                //     position: { my: "bottom right", at: "bottom right", offset: "-20 -20" }
                // });

                // Refresh Grid
                if (grid) {
                    grid.refresh();
                }
            });

            // เริ่มการเชื่อมต่อ
            connection.start().catch(function (err) {
                console.error("SignalR Connection Error: ", err.toString());
            });
        });
    </script>
}