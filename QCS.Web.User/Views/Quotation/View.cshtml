@model string
@using QCS.Domain.Enum
@using QCS.Infrastructure.Services

@{
    ViewData["Title"] = $"{Model}";
    Layout = "_DevExtremeLayout";
    ViewData["HideNav"] = true;
}

@section Styles {
    <link href="~/css/pages/quotation-view.css" rel="stylesheet" />
}

<div class="viewer-container">
    <div class="pdf-section">
        <div class="pdf-toolbar">
            <div class="pdf-title">
                <i class="fas fa-file-alt"></i>
                <span id="docTitleLabel">Document Viewer</span>
            </div>

            <button class="btn btn-sm btn-outline-primary ms-auto me-1" id="btnDownload" style="display:none;" disabled>
                <i class="fas fa-download"></i> Download
            </button>

            <button class="btn btn-sm btn-outline-secondary" id="btnFullscreen">
                <i class="fas fa-expand"></i> Fullscreen
            </button>
        </div>
        <div id="pdfViewer" class="pdf-body">
            <div class="pdf-placeholder">
                <i class="fas fa-search fa-3x mb-3 opacity-50"></i>
                <div>Generating Document...</div>
            </div>
        </div>
    </div>

    <div class="info-section">
        <div id="actionCard" class="info-card" style="display:none;">
            <div id="actionButtonContainer" class="d-flex gap-2 w-100"></div>
        </div>

        <div class="info-scroll-wrapper">
            <div class="info-card">
                <div class="card-header-text">
                    <span><i class="fas fa-info-circle"></i> Info</span>
                    <span id="headerStatus"></span>
                </div>
                <div id="requestInfoForm"></div>
            </div>

            <div class="info-card" style="min-height: 200px;">
                <div class="card-header-text">
                    <span><i class="fas fa-paperclip"></i> Attachments</span>
                    <span id="attachmentCount" class="badge rounded-pill" style="background-color: #6c757d; color: white;">0</span>
                </div>
                <div id="documentList"></div>
            </div>

            <div class="info-card">
                <div class="card-header-text">
                    <span><i class="fas fa-route"></i> Approval Flow</span>
                </div>
                <div id="approvalList" class="timeline"></div>
            </div>
        </div>
    </div>
</div>

<div id="actionPopup">
    <div class="p-2">
        <script>
            window.QcsPageConfig = {
                docCode: '@Model',
                documentTypes: @Html.Raw(Json.Serialize(EnumHelper.ToList<DocumentType>())),
                workflowStepSource: @Html.Raw(Json.Serialize(EnumHelper.ToList<WorkflowStep>())),
                approvalStatuses: @Html.Raw(Json.Serialize(EnumHelper.ToList<ApprovalStatus>()))
            };
        </script>
        <script src="~/js/pages/quotation-view.js"></script>
                if (!document.fullscreenElement) {
                    if (el.requestFullscreen) el.requestFullscreen();
                    else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
                } else {
                    if (document.exitFullscreen) document.exitFullscreen();
                }
            }
        });
    </script>
}