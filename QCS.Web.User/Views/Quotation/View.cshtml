@model string
@using QCS.Domain.Enum
@using QCS.Infrastructure.Services

@{
    ViewData["Title"] = $"{Model}";
    Layout = "_DevExtremeLayout";
    ViewData["HideNav"] = true;
}

@section Styles {
    <link href="~/css/pages/quotation-view.css" rel="stylesheet" />
}

<div class="viewer-container">
    <h1 class="visually-hidden">@ViewData["Title"]</h1>
    <div class="pdf-section">
        <div class="pdf-toolbar">
            <div class="pdf-title">
                <i class="fas fa-file-alt"></i>
                <span id="docTitleLabel">เอกสาร (Document)</span>
            </div>

            <button class="btn btn-sm btn-outline-primary ms-auto me-1" id="btnDownload" style="display:none;" disabled aria-label="ดาวน์โหลดเอกสาร PDF (Download PDF)" title="ดาวน์โหลดเอกสาร PDF (Download PDF)">
                <i class="fas fa-download"></i> ดาวน์โหลด (Download)
            </button>

            <button class="btn btn-sm btn-outline-secondary" id="btnFullscreen" aria-label="เปิดเอกสารแบบเต็มจอ (Fullscreen)" title="เปิดหรือปิดโหมดเต็มจอ (Toggle Fullscreen)">
                <i class="fas fa-expand"></i> เต็มจอ (Fullscreen)
            </button>
        </div>
        <div id="pdfViewer" class="pdf-body">
            <div class="pdf-placeholder">
                <i class="fas fa-search fa-3x mb-3 opacity-50"></i>
                <div>กำลังโหลดเอกสาร... (Loading Document...)</div>
            </div>
        </div>
    </div>

    <div class="info-section">
        <div id="actionCard" class="info-card d-none">
            <div id="actionButtonContainer" class="d-flex gap-2 w-100"></div>
        </div>

        <div class="info-scroll-wrapper">
            <div class="info-card">
                <div class="card-header-text">
                    <span><i class="fas fa-info-circle"></i> ข้อมูล (Information)</span>
                    <span id="headerStatus"></span>
                </div>
                <div id="requestInfoForm"></div>
            </div>

            <div class="info-card" style="min-height: 200px;">
                <div class="card-header-text">
                    <span><i class="fas fa-paperclip"></i> เอกสารแนบ (Attachments)</span>
                    <span id="attachmentCount" class="badge rounded-pill bg-secondary text-white">0</span>
                </div>
                <div id="documentList"></div>
            </div>

            <div class="info-card">
                <div class="card-header-text">
                    <span><i class="fas fa-route"></i> ลำดับอนุมัติ (Approval Workflow)</span>
                </div>
                <div id="approvalList" class="timeline"></div>
            </div>
        </div>
    </div>
</div>

<div id="actionPopup">
    <div class="p-2">
        <script>
            window.QcsPageConfig = {
                docCode: '@Model',
                documentTypes: @Html.Raw(Json.Serialize(EnumHelper.ToList<DocumentType>())),
                workflowStepSource: @Html.Raw(Json.Serialize(EnumHelper.ToList<WorkflowStep>())),
                approvalStatuses: @Html.Raw(Json.Serialize(EnumHelper.ToList<ApprovalStatus>()))
            };
        </script>
        <script src="~/js/pages/quotation-view.js"></script>
    </div>
</div>