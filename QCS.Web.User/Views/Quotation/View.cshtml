@model string

@{
    ViewData["Title"] = $"{Model}";
    Layout = "_NoNavLayout";
}

<div class="viewer-container">
    <!-- PDF Section -->
    <div class="pdf-section">
        <div class="pdf-toolbar">
            <div class="pdf-title">
                <i class="fas fa-file-alt"></i>
                <span id="docTitleLabel">Document Viewer</span>
            </div>
            <button class="btn btn-sm btn-outline-secondary" id="btnFullscreen">
                <i class="fas fa-expand"></i> Fullscreen
            </button>
        </div>
        <div id="pdfViewer" class="pdf-body">
            <div class="pdf-placeholder">
                <i class="fas fa-search fa-3x mb-3 opacity-50"></i>
                <div>Generating Document...</div>
            </div>
        </div>
    </div>

    <!-- Info Section -->
    <div class="info-section">
        <!-- Scrollable Content (No Action Card for read-only view) -->
        <div class="info-scroll-wrapper">
            <!-- Request Info -->
            <div class="info-card">
                <div class="card-header-text">
                    <span><i class="fas fa-info-circle"></i> Request Info</span>
                    <span id="headerStatus"></span>
                </div>
                <div id="requestInfoForm"></div>
            </div>

            <!-- Attachments -->
            <div class="info-card" style="min-height: 200px;">
                <div class="card-header-text">
                    <span><i class="fas fa-paperclip"></i> Attachments</span>
                    <span id="attachmentCount" class="badge rounded-pill" style="background-color: #6c757d; color: white;">0</span>
                </div>
                <div id="documentList"></div>
            </div>

            <!-- Approval Flow -->
            <div class="info-card">
                <div class="card-header-text">
                    <span><i class="fas fa-route"></i> Approval Flow</span>
                </div>
                <div id="approvalList" class="timeline"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // ==========================================
            // 1. CONFIG
            // ==========================================
            const DOC_CODE = "@Model";
            const API = {
                GET_DATA: `${API_BASE}/Quotation/ByCode`,
                VIEW_FILE: `${API_BASE}/Quotation/ViewFile`
            };

            // [REF_ENUM] Helper สำหรับจัดการสถานะและสี
            const getStatusBadgeInfo = (status) => {
                let badgeClass = "bg-secondary-soft"; // Draft or Default

                // กำหนดสีตาม Status ID
                if (status === 1) badgeClass = "bg-warning-soft"; // Pending
                else if (status === 2 || status === 3) badgeClass = "bg-success-soft"; // Approved/Completed
                else if (status === 9 || status === 99) badgeClass = "bg-danger-soft"; // Rejected

                // ดึงชื่อภาษาไทยจาก SystemEnums (Global Variable)
                const text = (typeof SystemEnums !== 'undefined')
                    ? SystemEnums.getDisplayName('requestStatus', status)
                    : "Status " + status;

                return { cls: badgeClass, txt: text };
            };

            // ==========================================
            // 2. INIT
            // ==========================================
            if (DOC_CODE) loadData();
            else showError("Document Code is missing.");

            async function loadData() {
                const loader = createLoader("Loading Data...");
                try {
                    const url = new URL(API.GET_DATA, window.location.origin);
                    url.searchParams.append("code", DOC_CODE);

                    const res = await fetch(url, { credentials: 'include' });
                    if (!res.ok) throw new Error("Document not found.");

                    let data = await res.json();
                    if (data.data) data = data.data;
                    if (Array.isArray(data)) data = data[0];
                    if (!data) throw new Error("No data returned.");

                    renderHeader(data);
                    renderForm(data);
                    renderDocuments(data.quotations);

                    const steps = data.approvalSteps || [];
                    renderApprovals(steps);

                    if (data.id) {
                        loadViewer(data.id, data.code);
                    } else {
                        $("#pdfViewer").html('<div class="pdf-placeholder">Document ID not found</div>');
                    }

                    $("#btnFullscreen").on("click", toggleFullscreen);
                } catch (err) {
                    showError(err.message);
                } finally {
                    loader.hide();
                }
            }

            // ==========================================
            // 3. RENDERING
            // ==========================================
            function renderHeader(data) {
                const info = getStatusBadgeInfo(data.status);
                $("#headerStatus").html(`<span class="status-badge ${info.cls}">${info.txt}</span>`);
            }

            function renderForm(data) {
                $("#requestInfoForm").dxForm({
                    formData: data,
                    readOnly: true,
                    labelLocation: "top",
                    colCount: 2,
                    items: [
                        { dataField: "code", label: { text: "No." }, colSpan: 2 },
                        { dataField: "title", label: { text: "Title" }, colSpan: 2 },
                        {
                            dataField: "vendorCode",
                            label: { text: "Vendor Code" },
                            colSpan: 2
                        },
                        {
                            dataField: "vendorName",
                            label: { text: "Vendor Name" },
                            colSpan: 2
                        },
                        {
                            dataField: "validFrom", 
                            label: { text: "Valid From" },
                            editorType: "dxDateBox", 
                            editorOptions: { displayFormat: "yyyy-MM-dd" }
                        },
                        {
                            dataField: "validUntil", 
                            label: { text: "Valid Until" },
                            editorType: "dxDateBox", 
                            editorOptions: { displayFormat: "yyyy-MM-dd" }
                        },
                        {
                            dataField: "remark", 
                            label: { text: "Remark" }, 
                            colSpan: 2,
                            editorType: "dxTextArea", 
                            editorOptions: { autoResizeEnabled: true, minHeight: 60 }
                        }
                    ]
                });
            }

            function renderDocuments(docs) {
                const container = $("#documentList").empty();
                $("#attachmentCount").text(docs ? docs.length : 0);

                if (!docs || docs.length === 0) {
                    container.html('<div class="text-center text-muted small p-3">No attachments</div>');
                    return;
                }

                docs.forEach(doc => {
                    const typeName = (typeof SystemEnums !== 'undefined')
                        ? SystemEnums.getDisplayName('documentType', doc.documentTypeId)
                        : "Type " + doc.documentTypeId;

                    const sizeStr = formatSize(doc.fileSize);

                    const item = $(`
                        <div class="file-item" data-id="${doc.id}">
                            <i class="fas fa-file-pdf file-icon"></i>
                            <div class="file-details">
                                <div class="file-name" title="${doc.fileName}">${doc.fileName}</div>
                                <div class="file-meta">
                                    <span class="badge bg-light text-dark border me-1">${typeName}</span>
                                    <span>${sizeStr}</span>
                                </div>
                            </div>
                        </div>
                    `);
                    container.append(item);
                });
            }

            function renderApprovals(steps) {
                const container = $("#approvalList").empty();
                if (!steps || steps.length === 0) {
                    container.html('<div class="text-center text-muted small p-3">No approval history</div>');
                    return;
                }

                steps.sort((a, b) => a.sequence - b.sequence);

                steps.forEach(step => {
                    let dotClass = "";
                    if (step.status === 2) dotClass = "completed";
                    else if (step.status === 9 || step.status === 99) dotClass = "rejected";
                    else if (step.status === 1) dotClass = "current";

                    const stepStatusText = (typeof SystemEnums !== 'undefined')
                        ? SystemEnums.getDisplayName('approvalStatus', step.status)
                        : "Waiting";

                    const approver = step.approverName || "System/Waiting";
                    const dateStr = formatDateTime(step.actionDate);

                    const html = `
                        <div class="timeline-item">
                            <div class="timeline-dot ${dotClass}"></div>
                            <div class="timeline-content">
                                <div class="timeline-step">Step ${step.sequence}: ${step.stepName}</div>
                                <div class="timeline-user">
                                    <i class="fas fa-user-circle"></i> ${approver}
                                    <span class="text-muted">(${stepStatusText})</span>
                                </div>
                                ${step.actionDate ? `<div class="timeline-date"><i class="far fa-clock"></i> ${dateStr}</div>` : ''}
                                ${step.comment ? `<div class="timeline-comment">"${step.comment}"</div>` : ''}
                            </div>
                        </div>
                    `;
                    container.append(html);
                });
            }

            async function loadViewer(requestId, code) {
                $("#docTitleLabel").text(`${code}`);
                const viewer = $("#pdfViewer").empty();
                const loader = createLoader("Generating PDF...", "#pdfViewer");

                try {
                    const url = `${API.VIEW_FILE}/${requestId}`;
                    const res = await fetch(url, { method: 'GET', credentials: 'include' });

                    if (!res.ok) {
                        let errorMsg = "Unable to load file content.";
                        try { errorMsg = await res.text(); } catch {}
                        throw new Error(errorMsg);
                    }

                    const blob = await res.blob();
                    const objUrl = URL.createObjectURL(blob);

                    $("<embed>").attr({ 
                        src: objUrl, 
                        type: "application/pdf", 
                        width: "100%", 
                        height: "100%" 
                    }).appendTo(viewer);

                } catch (e) {
                    viewer.html(`<div class="error-message text-danger p-4"><i class="fas fa-exclamation-triangle"></i> ${e.message}</div>`);
                } finally {
                    loader.hide();
                }
            }

            // ==========================================
            // 4. UTILS
            // ==========================================
            function formatSize(b) {
                if (!b) return "0 B";
                const i = Math.floor(Math.log(b) / Math.log(1024));
                return (b / Math.pow(1024, i)).toFixed(1) + " " + ["B", "KB", "MB", "GB"][i];
            }

            function formatDateTime(dateStr) {
                if (!dateStr) return "-";
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return "-";
                const pad = (n) => n.toString().padStart(2, '0');
                return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
            }

            function createLoader(msg, target = "body") {
                if (typeof DevExpress === 'undefined') return { hide: () => { } };
                const id = "local-loader-" + Math.floor(Math.random() * 1000);
                const $el = $("<div>").attr("id", id).appendTo(target);

                const loadPanel = $el.dxLoadPanel({
                    shadingColor: "rgba(255,255,255,0.7)",
                    position: { of: target },
                    visible: true,
                    showIndicator: true,
                    showPane: true,
                    message: msg,
                    container: target
                }).dxLoadPanel("instance");
                return { hide: () => { loadPanel.hide(); $el.remove(); } };
            }

            function showError(msg) {
                if (typeof DevExpress !== 'undefined') DevExpress.ui.notify(msg, "error", 4000);
                else alert(msg);
            }

            function toggleFullscreen() {
                const el = document.getElementById("pdfViewer");
                if (!document.fullscreenElement) {
                    if (el.requestFullscreen) el.requestFullscreen();
                    else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
                } else {
                    if (document.exitFullscreen) document.exitFullscreen();
                }
            }
        });
    </script>
}
