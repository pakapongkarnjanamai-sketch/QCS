@using QCS.Domain.Enum
@using QCS.Infrastructure.Services

@{
    ViewData["Title"] = "พื้นที่งาน (Workspace)";
    Layout = "_DevExtremeLayout";
}

@section Styles {
    <link href="~/css/pages/workspace.css" rel="stylesheet" />
}

<div class="container-fluid full-height-container mt-3">
    <h1 class="visually-hidden">@ViewData["Title"]</h1>
    <div class="qcs-card-content" id="main-dashboard-card">

        <div class="workspace-filter-panel mb-3">
            <div class="workspace-filter-bar">
                <!-- Scrollable filter chips area -->
                <div class="workspace-filter-scroll">
                    <div id="workspaceAllFilters" class="d-flex gap-2 workspace-filter-group"></div>
                    <div class="workspace-filter-separator"></div>
                    <div id="workspaceMyFilters" class="d-flex gap-2 workspace-filter-group"></div>
                </div>
                <!-- Pinned action button — always visible -->
                <div class="workspace-action-group">
                    <button id="btnResetGridState" type="button" class="btn btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 workspace-filter-btn" title="ล้างการกรองและจัดเรียงตาราง (Reset Grid Filters & Sort)">
                        <i class="fas fa-rotate-left" aria-hidden="true"></i>
                        <span>รีเซ็ตตาราง (Reset Grid)</span>
                    </button>
                    <button id="btnCreateHeader" type="button" class="btn btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 workspace-filter-btn workspace-action-btn">
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        <span>สร้างใบเสนอราคา (Create Quotation)</span>
                    </button>
                </div>
            </div>
        </div>



        <div id="workspaceGridWrapper" class="grid-wrapper">
            <div id="workspaceGrid"></div>
        </div>

        <div id="emptyState" class="workspace-empty-state d-none text-center h-100 d-flex flex-column justify-content-center align-items-center">
            <div class="workspace-empty-icon p-4 rounded-circle bg-light mb-3">
                <i class="fas fa-inbox fa-3x text-muted opacity-50"></i>
            </div>
            <h2 id="emptyStateTitle" class="h5 text-muted mb-2">ยังไม่มีรายการ (No items)</h2>
        </div>
        <div id="loadingIndicator"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.QcsPageConfig = {
            formUrl: '@Url.Action("Form", "Request")',
            codeUrl: '@Url.Action("View", "Quotation")',
            homeUrl: '@Url.Action("Index", "Home")',
            workflowStepsSource: @Html.Raw(Json.Serialize(EnumHelper.ToList<WorkflowStep>()))
        };
    </script>
    <script src="~/js/pages/home-index.js"></script>
}