@{
    ViewData["Title"] = "My Tasks & Requests";
    Layout = "_DevExtremeLayout";
}

<div class="container full-height-container mt-3">
    <div class="qcs-card-content" id="main-dashboard-card">

        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-shrink-0">
            <h6 class="m-0 fw-bold text-header">
                <i class="fas fa-clipboard-list me-2" style="color: var(--dx-primary-color);"></i> @ViewData["Title"]
            </h6>

            <button id="btnCreateHeader" class="btn btn-sm px-3 shadow-sm" style="background-color: var(--dx-primary-color); color: white; border: none;">
                <i class="fas fa-plus me-1"></i> สร้างใบเสนอราคาใหม่
            </button>
        </div>

        <div id="tabPanel"></div>

        <div id="emptyState" class="d-none text-center h-100 d-flex flex-column justify-content-center align-items-center">
            <div class="p-4 rounded-circle bg-light mb-3">
                <i class="fas fa-inbox fa-3x text-muted opacity-50"></i>
            </div>
            <h5 class="text-muted mb-3">ไม่มีข้อมูลเอกสารในขณะนี้</h5>
            <button id="btnCreateEmpty" class="btn px-4 rounded-pill" style="background-color: var(--dx-primary-color); color: white; border: none;">
                <i class="fas fa-plus me-2"></i>สร้างใบเสนอราคาใหม่
            </button>
        </div>
        <div id="loadingIndicator"></div>
    </div>
</div>

<script>
    $(function () {
        // === CONFIG ===
        const FORM_URL = '@Url.Action("Form", "Request")';
        const CODE_URL = '@Url.Action("Code", "Request")';

        // === HELPER: Status Badge (ปรับปรุงตาม WorkflowStep) ===
        const getStatusBadgeInfo = (status) => {
            let badgeClass = "bg-secondary-soft";
            let text = "Unknown";

            switch (status) {
                case 0: // Draft
                    badgeClass = "bg-secondary-soft";
                    text = "บันทึก (Draft)";
                    break;
                case 1: // Purchaser
                    badgeClass = "bg-info-soft";
                    text = "บันทึก (Purchaser)";
                    break;
                case 2: // Verifier
                    badgeClass = "bg-warning-soft";
                    text = "รอตรวจสอบ";
                    break;
                case 3: // Manager
                    badgeClass = "bg-warning-soft";
                    text = "รออนุมัติ";
                    break;
                case 99: // Completed
                    badgeClass = "bg-success-soft";
                    text = "อนุมัติครบถ้วน";
                    break;
                case -1: // Rejected
                    badgeClass = "bg-danger-soft";
                    text = "ไม่อนุมัติ";
                    break;
                default:
                    text = "Status " + status;
                    break;
            }

            // (Optional) หากมี SystemEnums ให้ใช้ชื่อจาก SystemEnums แทน
            if (typeof SystemEnums !== 'undefined') {
                text = SystemEnums.getDisplayName('workflowStep', status);
            }

            return { cls: badgeClass, txt: text };
        };

        const loadingIndicator = $("#loadingIndicator").dxLoadPanel({
            shadingColor: "rgba(0,0,0,0.4)",
            position: { of: "window" },
            visible: false,
            showIndicator: true,
            showPane: true,
            shading: true,
            message: "กำลังโหลดข้อมูล..."
        }).dxLoadPanel("instance");

        const handleDocClick = (paramValue, baseUrl, openInNewWindow) => {
            const url = `${baseUrl}/${encodeURIComponent(paramValue)}`;
            if (openInNewWindow) window.open(url, '_blank');
            else window.location.href = url;
        };

        function createRemoteStore(actionName) {
            return DevExpress.data.AspNet.createStore({
                key: "id",
                loadUrl: `${API_BASE}/Request/${actionName}`,
                onBeforeSend: (method, ajaxOptions) => {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            });
        }

        function createGridConfig(store, columns, placeholderText, targetUrl, openInNewWindow, paramField = 'id') {
            return {
                dataSource: {
                    store: store,
                    sort: [{ selector: "code", desc: true }],
                },
                remoteOperations: true,
                height: "100%",
                showBorders: true,
                rowAlternationEnabled: true,
                hoverStateEnabled: true,
                columnAutoWidth: true,
                allowColumnResizing: true,
                dateSerializationFormat: "yyyy-MM-ddTHH:mm:ss",
                filterRow: { visible: true },
                headerFilter: { visible: true },
                scrolling: { mode: "virtual" },
                paging: { pageSize: 20 },
                searchPanel: { visible: true, width: 300, placeholder: placeholderText },
                columns: columns,
                onRowDblClick: function(e) {
                    const val = e.data[paramField];
                    handleDocClick(val, targetUrl, openInNewWindow);
                }
            };
        }

        // === COLUMN DEFINITIONS ===
        const createColumns = (targetUrl, openInNewWindow, isTaskGrid = false, paramField = 'id') => {
            
            const baseColumns = [
                {
                    dataField: "code",
                    caption: "เลขที่เอกสาร",
                    width: 120,
                    cellTemplate: (container, options) => {
                        const docNo = options.value || "(Draft)";
                        const val = options.data[paramField];
                        $("<a>").addClass("doc-link")
                            .text(docNo)
                            .attr("href", "javascript:void(0)")
                            .on("click", (e) => {
                                e.stopPropagation();
                                handleDocClick(val, targetUrl, openInNewWindow);
                            })
                            .appendTo(container);
                    }
                },
                { dataField: "title", caption: "หัวข้อ", minWidth: 150 },
                {
                    dataField: "vendorName",
                    caption: "ผู้ขาย (Vendor)",
                    width: 320,
                    calculateDisplayValue: function(rowData) {
                        return rowData.vendorCode
                            ? `${rowData.vendorCode} : ${rowData.vendorName}`
                            : rowData.vendorName;
                    }
                },
                {
                    dataField: "requestDate",
                    caption: "วันที่ขอ",
                    dataType: "date",
                    format: "yyyy-MM-dd",
                    width: 120,
                    alignment: "center"
                },
                {
                    dataField: "currentStepId",
                    caption: "สถานะ",
                    width: 150,
                    alignment: "center",
                    lookup: {
                        dataSource: [
                            { id: 0, name: "บันทึก (Draft)" },
                            { id: 1, name: "บันทึก (Purchaser)" },
                            { id: 2, name: "รอตรวจสอบ (Verifier)" },
                            { id: 3, name: "รออนุมัติ (Manager)" },
                            { id: 99, name: "อนุมัติครบถ้วน (Completed)" },
                            { id: -1, name: "ไม่อนุมัติ (Rejected)" }
                        ],
                        valueExpr: "id", 
                        displayExpr: "name"
                    },
                    cellTemplate: (container, options) => {
                        const info = getStatusBadgeInfo(options.value);
                        $("<span>").addClass("status-badge " + info.cls).text(info.txt).appendTo(container);
                    }
                },
                {
                    type: "buttons", 
                    width: 70,
                    buttons: [{
                        hint: "เปิดดู", 
                        icon: "find",
                        onClick: (e) => {
                            const val = e.row.data[paramField];
                            handleDocClick(val, targetUrl, openInNewWindow);
                        }
                    }]
                }
            ];

            if (isTaskGrid) {
                const requesterCol = { dataField: "requesterName", caption: "ผู้ขอ", width: 180 };
                return [
                    ...baseColumns.slice(0, 2),
                    requesterCol,
                    ...baseColumns.slice(2)
                ];
            }

            return baseColumns;
        };

        loadSummaryData();

        $("#btnCreateHeader, #btnCreateEmpty").on("click", function() {
            window.location.href = FORM_URL;
        });

        function loadSummaryData() {
            loadingIndicator.show();
            $.ajax({
                url: `${API_BASE}/Dashboard/Summary`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (data) {
                    loadingIndicator.hide();
                    initTabPanel(data.myTaskCount);
                },
                error: function(err) {
                    loadingIndicator.hide();
                    initTabPanel(0);
                }
            });
        }

        function initTabPanel(taskCount) {
            const tabs = [];
            
            if (taskCount > 0) {
                tabs.push({
                    title: "งานรออนุมัติ (My Tasks)",
                    icon: "todo",
                    badgeCount: taskCount,
                    template: () => {
                        const grid = $("<div>").attr("id", "gridMyTasks");
                        const store = createRemoteStore("GetMyTasks");
                        const columns = createColumns(CODE_URL, true, true, 'code');
                        grid.dxDataGrid(createGridConfig(store, columns, "ค้นหางานที่ต้องอนุมัติ...", CODE_URL, true, 'code'));
                        return $("<div>").addClass("grid-wrapper").append(grid);
                    }
                });
            }

            tabs.push({
                title: "เอกสารของฉัน (My Requests)",
                icon: "user",
                template: () => {
                    const grid = $("<div>").attr("id", "gridMyRequests");
                    const store = createRemoteStore("GetMyRequests");
                    const columns = createColumns(FORM_URL, false, false, 'id');
                    grid.dxDataGrid(createGridConfig(store, columns, "ค้นหาเอกสารของฉัน...", FORM_URL, false, 'id'));
                    return $("<div>").addClass("grid-wrapper").append(grid);
                }
            });

            tabs.push({
                title: "อนุมัติแล้ว (Approved)",
                icon: "check",
                template: () => {
                    const grid = $("<div>").attr("id", "gridApproved");
                    const store = createRemoteStore("MyApprovedList");
                    const columns = createColumns(FORM_URL, false, false, 'id');
                    grid.dxDataGrid(createGridConfig(store, columns, "ค้นหาเอกสารที่อนุมัติแล้ว...", FORM_URL, false, 'id'));
                    return $("<div>").addClass("grid-wrapper").append(grid);
                }
            });

            tabs.push({
                title: "ไม่อนุมัติ (Rejected)",
                icon: "revert",
                template: () => {
                    const grid = $("<div>").attr("id", "gridRejected");
                    const store = createRemoteStore("GetRejectedRequests");
                    const columns = createColumns(FORM_URL, false, false, 'id');
                    grid.dxDataGrid(createGridConfig(store, columns, "ค้นหาเอกสารที่ไม่อนุมัติ...", FORM_URL, false, 'id'));
                    return $("<div>").addClass("grid-wrapper").append(grid);
                }
            });

            $("#tabPanel").dxTabPanel({
                items: tabs,
                height: "100%",
                deferRendering: true,
                itemTitleTemplate: function(itemData) {
                    const container = $("<div>").addClass("d-flex align-items-center gap-2");
                    if(itemData.icon) container.append($("<i>").addClass("dx-icon-" + itemData.icon));
                    container.append($("<span>").text(itemData.title));

                    if (itemData.badgeCount !== undefined && itemData.badgeCount > 0) {
                        container.append(
                            $("<span>")
                                .addClass("badge rounded-pill ms-2")
                                .css({
                                    "background-color": "#dc3545",
                                    "color": "white"
                                })
                                .text(itemData.badgeCount)
                        );
                    }

                    return container;
                }
            });
        }
    });
</script>
