@{
    ViewData["Title"] = "My Tasks & Requests";
}

@section Styles {
    <style>
        /* --- Layout & Container --- */
        .full-height-container {
            height: calc(100vh - 80px);
            display: flex;
            flex-direction: column;
            padding-bottom: 20px;
        }

        .qcs-card-content {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            padding: 20px;
            border: none;
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        /* --- TabPanel Customization --- */
        #tabPanel {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

            #tabPanel .dx-tabpanel-container,
            #tabPanel .dx-multiview-wrapper,
            #tabPanel .dx-multiview-item-container,
            #tabPanel .dx-multiview-item,
            #tabPanel .dx-multiview-item-content {
                height: 100%;
                display: flex;
                flex-direction: column;
            }

            #tabPanel .dx-tabs {
                border-bottom: 1px solid #f1f3f5;
                background-color: transparent;
                flex-shrink: 0;
                margin-bottom: 10px;
            }

            #tabPanel .dx-tab {
                background-color: transparent !important;
                padding: 10px 20px;
            }

            #tabPanel .dx-tab-text {
                font-family: 'Segoe UI', sans-serif;
                font-size: 1rem;
                font-weight: 600;
                color: #6c757d;
                text-transform: none;
            }

            #tabPanel .dx-tab-selected {
                border-bottom: 3px solid #258cfb;
                color: #258cfb;
            }

                #tabPanel .dx-tab-selected .dx-tab-text {
                    color: #258cfb;
                }

        /* --- Grid & Content --- */
        .grid-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
            padding: 5px;
        }

            .grid-wrapper .dx-datagrid {
                height: 100%;
            }

        .doc-link {
            color: #258cfb;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            transition: color 0.2s;
        }

            .doc-link:hover {
                color: #0a58ca;
                text-decoration: underline;
            }

        .text-header {
            color: #2c3e50;
        }

        /* --- Badges (Standardized) --- */
        .status-badge {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
        }

        .bg-success-soft {
            background: #d4edda;
            color: #155724;
        }

        .bg-warning-soft {
            background: #fff3cd;
            color: #856404;
        }

        .bg-danger-soft {
            background: #f8d7da;
            color: #721c24;
        }

        .bg-secondary-soft {
            background: #e2e3e5;
            color: #383d41;
        }

        .bg-info-soft {
            background: #cff4fc;
            color: #055160;
        }

    </style>
}

<div class="container full-height-container mt-3">
    <div class="qcs-card-content" id="main-dashboard-card">

        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom flex-shrink-0">
            <h6 class="m-0 fw-bold text-header">
                <i class="fas fa-clipboard-list text-primary me-2"></i> @ViewData["Title"]
            </h6>

            <button id="btnCreateHeader" class="btn btn-primary btn-sm px-3 shadow-sm">
                <i class="fas fa-plus me-1"></i> สร้างใบเสนอราคาใหม่
            </button>
        </div>

        <div id="tabPanel"></div>

        <div id="emptyState" class="d-none text-center h-100 d-flex flex-column justify-content-center align-items-center">
            <div class="p-4 rounded-circle bg-light mb-3">
                <i class="fas fa-inbox fa-3x text-muted opacity-50"></i>
            </div>
            <h5 class="text-muted mb-3">ไม่มีข้อมูลเอกสารในขณะนี้</h5>
            <button id="btnCreateEmpty" class="btn btn-primary px-4 rounded-pill">
                <i class="fas fa-plus me-2"></i>สร้างใบเสนอราคาใหม่
            </button>
        </div>

    </div>
</div>
@section Scripts {
    <script>
        $(function () {
            // === CONFIG ===
     
            const FORM_URL = '@Url.Action("Form", "Request")';

            // === HELPER: Status Badge ===
             const getStatusBadgeInfo = (status) => {
                let badgeClass = "bg-secondary-soft"; // Draft (0)

                if (status === 1) badgeClass = "bg-warning-soft"; // Pending
                else if (status === 2) badgeClass = "bg-success-soft"; // Approved
                else if (status === 3) badgeClass = "bg-info-soft";    // Completed
                else if (status === 9 || status === 99) badgeClass = "bg-danger-soft"; // Rejected

                // ดึงชื่อภาษาไทยจาก SystemEnums (Single Source of Truth)
                const text = (typeof SystemEnums !== 'undefined')
                    ? SystemEnums.getDisplayName('requestStatus', status)
                    : "Status " + status;

                return { cls: badgeClass, txt: text };
            };

            // === HELPER: สร้าง DataSourceStore ===
            function createRemoteStore(actionName) {
                return DevExpress.data.AspNet.createStore({
                    key: "id",
                    loadUrl: `${API_BASE}/Request/${actionName}`, // ตรวจสอบ Path API ให้ถูกต้อง
                    onBeforeSend: (method, ajaxOptions) => {
                        ajaxOptions.xhrFields = { withCredentials: true };
                    }
                });
            }

            // === HELPER: สร้าง Grid Configuration (แก้ไขเพิ่ม Sort) ===
            function createGridConfig(store, columns, placeholderText) {
                return {
                    // ✅ 1. ปรับปรุง dataSource เพื่อเพิ่มการ Sort ตาม code
                    dataSource: {
                        store: store,
                        sort: [{ selector: "code", desc: true }] // true = ล่าสุดขึ้นก่อน (Z-A), false = เรียงตามตัวเลข (A-Z)
                    },
                    remoteOperations: true,
                    height: "100%",
                    showBorders: true,
                    rowAlternationEnabled: true,
                    hoverStateEnabled: true,
                    columnAutoWidth: true,
                    allowColumnResizing: true,
                    dateSerializationFormat: "yyyy-MM-ddTHH:mm:ss",
                    filterRow: { visible: true },
                    headerFilter: { visible: true },
                    scrolling: { mode: "virtual" },
                    paging: { pageSize: 20 },
                    searchPanel: { visible: true, width: 300, placeholder: placeholderText },
                    columns: columns,
                    onRowDblClick: function(e) {
                        window.location.href = `${FORM_URL}?id=${e.data.id}&mode=view`;
                    }
                };
            }

            // === COLUMN DEFINITIONS ===
            const commonColumns = [
                {
                    dataField: "code",
                    caption: "เลขที่เอกสาร",
                    width: 160,
                    cellTemplate: (container, options) => {
                        const docNo = options.value || "(Draft)";
                        $("<a>").addClass("doc-link")
                            .text(docNo)
                            .attr("href", `${FORM_URL}?id=${options.data.id}&mode=view`)
                            .on("click", (e) => e.stopPropagation())
                            .appendTo(container);
                    }
                },
                { dataField: "title", caption: "หัวข้อ", minWidth: 200 },
                { dataField: "vendorName", caption: "ผู้ขาย", width: 200 },
                {
                    dataField: "requestDate",
                    caption: "วันที่ขอ",
                    dataType: "date",
                    format: "dd/MM/yyyy",
                    width: 120,
                    alignment: "center"
                },
                {
                    dataField: "status",
                    caption: "สถานะ",
                    width: 140,
                    alignment: "center",
                    lookup: {
                        dataSource: [
                            { id: 0, name: "Draft" },
                            { id: 1, name: "Pending" },
                            { id: 2, name: "Approved" },
                            { id: 3, name: "Rejected" }
                        ],
                        valueExpr: "id", displayExpr: "name"
                    },
                    cellTemplate: (container, options) => {
                        const info = getStatusBadgeInfo(options.value);
                        $("<span>").addClass("status-badge " + info.cls).text(info.txt).appendTo(container);
                    }
                },
                {
                    type: "buttons", width: 70,
                    buttons: [{
                        hint: "เปิดดู", icon: "find",
                        onClick: (e) => window.location.href = `${FORM_URL}?id=${e.row.data.id}&mode=view`
                    }]
                }
            ];

            const taskColumns = [
                ...commonColumns.slice(0, 2),
                { dataField: "requesterName", caption: "ผู้ขอซื้อ", width: 180 },
                ...commonColumns.slice(2)
            ];

            // === MAIN LOGIC ===
            loadSummaryData();

            $("#btnCreateHeader, #btnCreateEmpty").on("click", function() {
                window.location.href = FORM_URL;
            });

            function loadSummaryData() {
                // จำลองการเรียก API Summary (หรือเปิด Comment เพื่อเรียกจริง)
                 $.ajax({
                     url: `${API_BASE}/Dashboard/Summary`,
                     method: "GET",
                     xhrFields: { withCredentials: true },
                     success: function (data) {
                         initTabPanel(data.myRequestCount, data.myTaskCount, data.approvedCount);
                     },
                     error: function(err) {
                         // Fallback กรณี Error
                         initTabPanel(0, 0, 0);
                     }
                 });
            }

            function initTabPanel(requestCount, taskCount, approvedCount) {
                const tabs = [];

                // Tab 1: My Tasks
                tabs.push({
                    title: "งานรออนุมัติ (My Tasks)",
                    icon: "todo",
                    badge: taskCount,
                    template: () => {
                        const grid = $("<div>").attr("id", "gridMyTasks");
                        const store = createRemoteStore("GetMyTasks");
                        grid.dxDataGrid(createGridConfig(store, taskColumns, "ค้นหางานที่ต้องอนุมัติ..."));
                        return $("<div>").addClass("grid-wrapper").append(grid);
                    }
                });

                // Tab 2: My Requests
                tabs.push({
                    title: "เอกสารของฉัน (My Requests)",
                    icon: "user",
                    badge: requestCount,
                    template: () => {
                        const grid = $("<div>").attr("id", "gridMyRequests");
                        const store = createRemoteStore("GetMyRequests");
                        grid.dxDataGrid(createGridConfig(store, commonColumns, "ค้นหาเอกสารของฉัน..."));
                        return $("<div>").addClass("grid-wrapper").append(grid);
                    }
                });

                // Tab 3: Approved List
                tabs.push({
                    title: "อนุมัติแล้ว (Approved)",
                    icon: "check",
                    badge: approvedCount,
                    template: () => {
                        const grid = $("<div>").attr("id", "gridApproved");
                        const store = createRemoteStore("ApprovedList");
                        grid.dxDataGrid(createGridConfig(store, commonColumns, "ค้นหาเอกสารที่อนุมัติแล้ว..."));
                        return $("<div>").addClass("grid-wrapper").append(grid);
                    }
                });

                // Render TabPanel
                $("#tabPanel").dxTabPanel({
                    items: tabs,
                    height: "100%",

                    // ✅ 2. เปลี่ยนเป็น true เพื่อให้โหลด Content เฉพาะตอนกด Tab
                    deferRendering: true,

                    itemTitleTemplate: function(itemData) {
                        const container = $("<div>").addClass("d-flex align-items-center gap-2");
                        if(itemData.icon) container.append($("<i>").addClass("dx-icon-" + itemData.icon));
                        container.append($("<span>").text(itemData.title));
                        if (itemData.badge > 0) {
                            container.append($("<span>").addClass("badge bg-danger rounded-pill ms-2").text(itemData.badge));
                        }
                        return container;
                    }
                });
            }
        });
    </script>
}