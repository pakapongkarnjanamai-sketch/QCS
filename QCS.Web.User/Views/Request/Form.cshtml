@model int?
@using QCS.Domain.Enum
@using QCS.Infrastructure.Services

@{
    ViewData["Title"] = "สร้างใบเสนอราคา";
    Layout = "_DevExtremeLayout";
}

@section Styles {
    <link href="~/css/pages/request-form.css" rel="stylesheet" />
}

<div class="container mt-4 mb-5">
    <div class="qcs-card">
        <div class="row align-items-center g-3">

            <div class="col-12 col-xl me-auto">
                <h5 class="m-0 d-flex align-items-center text-primary-header">
                    <i class="fas fa-file-invoice-dollar me-2 flex-shrink-0" style="color: var(--dx-primary-color);"></i>

                    <div class="text-wrap lh-sm">
                        <span id="lblPageTitle" class="fw-bold">@ViewData["Title"]</span>
                        @if (Model.HasValue)
                        {
                            <span class="mx-2 text-muted opacity-25">|</span>
                            <span id="lblDocNo" class="fw-bold" style="color: var(--dx-primary-color);">กำลังโหลด...</span>
                        }
                    </div>
                </h5>
            </div>

            <div class="col-12 col-xl-auto">
                <div id="actionButtons"></div>
            </div>

        </div>
    </div>
    <div class="qcs-card" id="formContainer">
        <div class="section-header">
            <i class="fas fa-info-circle" style="color: var(--dx-primary-color);"></i>
            ข้อมูล
        </div>
        <div id="quotationForm"></div>
    </div>

    <div class="qcs-card">
        <div class="section-header">
            <i class="fas fa-route" style="color: var(--dx-primary-color);"></i>
            เส้นทางอนุมัติ
        </div>
        <div id="workflowRouteGrid"></div>
    </div>
</div>

<div id="historyPopup"></div>
<div id="actionPopup">
    <div class="p-2">
        <div id="actionReasonBox"></div>
        <div class="mt-3 d-flex justify-content-end gap-2">
            <div id="btnCancelAction"></div>
            <div id="btnConfirmAction"></div>
        </div>
    </div>
</div>
<div id="loadingIndicator"></div>

@section Scripts {
    <script>
        window.QcsPageConfig = {
            prId: @(Model.HasValue ? Model.Value.ToString() : "null"),
            homeUrl: '@Url.Action("Index", "Home")',
            docTypesSource: @Html.Raw(Json.Serialize(EnumHelper.ToList<DocumentType>())),
            approvalStatuses: @Html.Raw(Json.Serialize(EnumHelper.ToList<ApprovalStatus>()))
        };
    </script>
    <script src="~/js/pages/request-form.js"></script>
}