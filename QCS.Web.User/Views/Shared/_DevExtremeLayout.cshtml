@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    // ตรวจสอบว่าต้องซ่อนเมนูหรือไม่ (ค่า default คือ false = แสดงเมนู)
    bool hideNav = ViewData["HideNav"] as bool? ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QCS - @ViewData["Title"]</title>

    @await RenderSectionAsync("ExternalDependencies", required: false)

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="~/css/devextreme/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.compact.css" rel="stylesheet" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />
    <link href="~/css/core/variables.css" rel="stylesheet" />
    <link href="~/css/layout/containers.css" rel="stylesheet" />
    <link href="~/css/layout/navbar.css" rel="stylesheet" />
    <link href="~/css/components/badges.css" rel="stylesheet" />
    <link href="~/css/components/grid.css" rel="stylesheet" />
    <link href="~/css/components/tabs.css" rel="stylesheet" />
    <link href="~/css/components/attachments.css" rel="stylesheet" />
    <link href="~/css/utilities/helpers.css" rel="stylesheet" />
    
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/js/devextreme/filesaver.min.js"></script>
    <script src="~/js/devextreme/dx-exceljs-fork.min.js"></script>
    <script src="~/js/devextreme/jquery.js"></script>
    <script src="~/js/devextreme/bootstrap.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>
    <script src="~/src/devextreme-license.js"></script>
    <script src="~/lib/font-awesome/js/all.min.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @if (!hideNav)
    {
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-file-invoice-dollar me-2"></i>
                    QCS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                       
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="fas fa-user-circle me-1"></i> @(User.Identity?.Name ?? "Unknown User")
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }

    <main>
        @RenderBody()
    </main>



    <script>
        const API_BASE = '@Configuration["ApiSettings:BaseUrl"]';
        console.log("API_BASE:", API_BASE);
    </script>

    @* Shared JS: Core runtime *@
    <script src="~/js/site.js"></script>
    <script src="~/js/shared/loading.js"></script>
    <script src="~/js/shared/async-action.js"></script>
    <script src="~/js/shared/error-presenter.js"></script>
    <script src="~/js/shared/utils.js"></script>
    <script src="~/js/shared/status-badge.js"></script>

    @* Shared JS: UI interactions *@
    <script src="~/js/shared/file-view.js"></script>
    <script src="~/js/shared/action-dialog.js"></script>
    <script src="~/js/shared/toolbar.js"></script>
    <script src="~/js/shared/signalr.js"></script>

    @* Shared JS: Request domain helpers *@
    <script src="~/js/shared/approval-action.js"></script>
    <script src="~/js/shared/request-workflow.js"></script>
    <script src="~/js/shared/attachment-grid.js"></script>
    <script src="~/js/shared/request-form-validation.js"></script>
    <script src="~/js/shared/request-submission.js"></script>
    <script src="~/js/shared/request-grid.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>