<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>QCS - @ViewData["Title"]</title>

    @await RenderSectionAsync("ExternalDependencies", required: false)

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="~/css/devextreme/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.compact.css" rel="stylesheet" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />

    <script src="~/js/devextreme/filesaver.min.js"></script>
    <script src="~/js/devextreme/exceljs.min.js"></script>
    <script src="~/js/devextreme/jquery.js"></script>
    <script src="~/js/devextreme/bootstrap.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>
    <script src="~/src/devextreme-license.js"></script>

    <script src="~/lib/font-awesome/js/all.min.js"></script>

    <environment names="Development">
        <script src="~/host/development.js"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="~/host/production.js"></script>
    </environment>
    <script src="~/js/site.js"></script>

    <style>
        /* ==================== CSS VARIABLES (DevExtreme Theme Colors) ==================== */
        :root {
            --dx-primary-color: #337ab7;
            --dx-primary-dark: #2d6da3;
            --dx-primary-light: #4a90d9;
        }

        /* ==================== GLOBAL RESET ==================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f7fa;
            color: #2c3e50;
            overflow: hidden;
        }

        /* ==================== LAYOUT ==================== */
        .viewer-container {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 20px;
            height: 100vh;
            padding: 20px;
            box-sizing: border-box;
            background-color: #f5f7fa;
        }

        /* ==================== PDF VIEWER SECTION ==================== */
        .pdf-section {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: none;
        }

        .pdf-toolbar {
            padding: 12px 15px;
            background: #fff;
            border-bottom: 2px solid #f1f3f5;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }

        .pdf-title {
            font-weight: 700;
            color: #2c3e50;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .pdf-title i {
                color: var(--dx-primary-color);
            }

        .pdf-body {
            flex: 1;
            background: #525659;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .pdf-placeholder {
            color: #ccc;
            text-align: center;
        }

        .error-message {
            text-align: center;
            padding: 20px;
            color: #dc3545;
        }

        /* ==================== INFO PANEL SECTION ==================== */
        .info-section {
            display: flex;
            flex-direction: column;
            gap: 15px;
            height: 100%;
            overflow: hidden;
        }

        /* Action Card - Fixed at top (no scroll) */
        #actionCard {
            flex-shrink: 0;
        }

        /* Scroll Wrapper - Only this part scrolls */
        .info-scroll-wrapper {
            display: flex;
            flex-direction: column;
            gap: 15px;
            overflow-y: auto;
            flex: 1;
            padding-right: 5px;
        }

            /* Custom Scrollbar */
            .info-scroll-wrapper::-webkit-scrollbar {
                width: 6px;
            }

            .info-scroll-wrapper::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 10px;
            }

            .info-scroll-wrapper::-webkit-scrollbar-thumb {
                background: #888;
                border-radius: 10px;
            }

                .info-scroll-wrapper::-webkit-scrollbar-thumb:hover {
                    background: #555;
                }

        .info-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            flex-shrink: 0;
            border: none;
        }

        .card-header-text {
            font-size: 1.1rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 15px;
            border-bottom: 2px solid #f1f3f5;
            padding-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

            .card-header-text i {
                color: var(--dx-primary-color);
            }

        /* ==================== FILE LIST ==================== */
        .file-item {
            display: flex;
            align-items: center;
            padding: 12px;
            border: 1px solid #f1f3f5;
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s;
            background: #fff;
        }

            .file-item:hover {
                background-color: #f8f9fa;
                border-color: var(--dx-primary-color);
                transform: translateX(2px);
            }

            .file-item.active {
                background-color: #f0f9ff;
                border-color: var(--dx-primary-color);
            }

        .file-icon {
            font-size: 24px;
            color: #f05b41;
            margin-right: 15px;
            flex-shrink: 0;
        }

        .file-details {
            flex: 1;
            overflow: hidden;
        }

        .file-name {
            font-weight: 600;
            font-size: 13px;
            color: #2c3e50;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .file-meta {
            font-size: 11px;
            color: #6c757d;
            margin-top: 2px;
        }

        /* ==================== TIMELINE ==================== */
        .timeline {
            position: relative;
            padding-left: 25px;
            margin-top: 10px;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 8px;
                top: 5px;
                bottom: 5px;
                width: 2px;
                background: #e9ecef;
            }

        .timeline-item {
            position: relative;
            padding-bottom: 25px;
        }

            .timeline-item:last-child {
                padding-bottom: 0;
            }

        .timeline-dot {
            position: absolute;
            left: -25px;
            top: 4px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid #dee2e6;
            z-index: 1;
        }

            .timeline-dot.completed {
                border-color: #28a745;
                background: #28a745;
            }

            .timeline-dot.current {
                border-color: #ffc107;
                background: #fff;
            }

            .timeline-dot.rejected {
                border-color: #dc3545;
                background: #dc3545;
            }

        .timeline-step {
            font-weight: 600;
            font-size: 13px;
            color: #2c3e50;
        }

        .timeline-user {
            font-size: 12px;
            color: #555;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 2px;
        }

            .timeline-user i {
                color: var(--dx-primary-color);
            }

        .timeline-date {
            font-size: 11px;
            color: #6c757d;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .timeline-comment {
            margin-top: 8px;
            font-size: 12px;
            background: #f8f9fa;
            padding: 8px 12px;
            border-radius: 6px;
            border-left: 3px solid #ddd;
            color: #555;
            font-style: italic;
            white-space: pre-wrap;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        /* ==================== BADGES (Standardized) ==================== */
        .status-badge {
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
            text-align: center;
            white-space: nowrap;
        }

        .bg-success-soft {
            background: #d4edda;
            color: #155724;
        }

        .bg-warning-soft {
            background: #fff3cd;
            color: #856404;
        }

        .bg-danger-soft {
            background: #f8d7da;
            color: #721c24;
        }

        .bg-secondary-soft {
            background: #e2e3e5;
            color: #383d41;
        }

        .bg-info-soft {
            background: #cff4fc;
            color: #055160;
        }

        /* ==================== LINKS ==================== */
        .doc-link {
            color: var(--dx-primary-color);
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            transition: color 0.2s;
        }

            .doc-link:hover {
                color: var(--dx-primary-dark);
                text-decoration: underline;
            }

        /* ==================== UTILITIES ==================== */
        .text-highlight {
            color: var(--dx-primary-color);
        }

        .current-user-row {
            font-weight: 700;
            color: var(--dx-primary-color);
        }

        .opacity-50 {
            opacity: 0.5;
        }

        .rounded-pill {
            border-radius: 50rem !important;
        }

        .shadow-sm {
            box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
        }

        /* ==================== RESPONSIVE ==================== */
        @@media (max-width: 1024px) {
            .viewer-container {
                grid-template-columns: 1fr;
                height: auto;
                overflow-y: auto;
            }

            .pdf-section {
                height: 500px;
            }

            .info-section {
                height: auto;
                overflow: visible;
            }

            .info-scroll-wrapper {
                overflow: visible;
                height: auto;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
