{
  "ApiSettings": {
    "BaseUrl": "https://AP-NTC2137-PRWB/QCS/Service/api"
  },

  // Hands legacy portal traffic to the React portal at BasePath.
  //
  // Enabled is FALSE here on purpose and must stay false in the repo: deploying this code and
  // switching users over are two separate acts. A server's own appsettings.json turns it on, and
  // setting it back to false plus a pool recycle IS the rollback — no redeploy, no code revert.
  // The deploy scripts exclude appsettings.json, so a server keeps its own value.
  // See PLAN-040 in the QRS repo.
  "PortalCutover": {
    "Enabled": false,
    "BasePath": "/QCS/User"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
