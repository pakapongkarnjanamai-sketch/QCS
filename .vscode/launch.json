{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "QCS.API",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}/QCS.API/QCS.API.csproj",
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "\\bNow listening on:\\s+(https?://\\S+)",
				"uriFormat": "%s/swagger"
			}
		},
		{
			"name": "QCS.React.User",
			"type": "node-terminal",
			"request": "launch",
			"command": "npm run dev",
			"cwd": "${workspaceFolder}/QCS.React.User",
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "Local:\\s+(https?://\\S+)"
			}
		},
		{
			"name": "PDF.Service",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}/PDF.Service/PDF.Service.csproj",
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "\\bNow listening on:\\s+(https?://\\S+)",
				"uriFormat": "%s/swagger"
			}
		},
		{
			"name": "QCS.React.Admin",
			"type": "node-terminal",
			"request": "launch",
			"command": "npm run dev -- --host localhost --port 5846 --strictPort",
			"cwd": "${workspaceFolder}/QCS.React.Admin",
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "Local:\\s+(https?://\\S+)"
			}
		}
	],
	"compounds": [
		{
			"name": "Full System (API + PDF + React User + React Admin)",
			"configurations": [
				"QCS.API",
				"PDF.Service",
				"QCS.React.User",
				"QCS.React.Admin"
			],
			"stopAll": true
		},
		{
			"name": "Core Backend (API + PDF.Service)",
			"configurations": [
				"QCS.API",
				"PDF.Service"
			],
			"stopAll": true
		}
	]
}
