{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "API",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}/QCS.API/QCS.API.csproj"
		},
		{
			"name": "React",
			"type": "node-terminal",
			"request": "launch",
			"command": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
			"cwd": "${workspaceFolder}/QCS.React.Admin",
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": "Local:\\s+(https?://\\S+)"
			}
		},
		
	]
}
